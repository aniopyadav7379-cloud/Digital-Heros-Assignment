# --- Database ---
# Local Postgres (docker-compose):
DATABASE_URL="postgresql://leaddesk:leaddesk@localhost:5432/leaddesk?schema=public"
# Neon (production): postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Authentication ---
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="8h"

# --- Initial admin user (used only by `npm run prisma:seed`) ---
SEED_ADMIN_EMAIL="admin@leaddesk.dev"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
SEED_ADMIN_NAME="LeadDesk Admin"

# --- CORS ---
# Comma-separated list of origins allowed to call the API with credentials
# from a browser (e.g. a separate admin client). Leave empty for same-origin only.
CORS_ALLOWED_ORIGINS=""

# --- Rate limiting (requests per minute per IP) ---
LEAD_SUBMIT_RATE_LIMIT=10
LOGIN_RATE_LIMIT=5
